#!/bin/bash
############
# This is an example Duffle driver
#
# It implements `--handles` and `--help`, as well as handling the main
# operation.
############
set -eo pipefail

# Ensure jq is installed
if ! command -v jq &> /dev/null; then
    echo "jq is required but not installed. Please install jq to continue." >&2
    exit 1
fi

if [[ $1 == "--handles" ]]; then
    echo docker,oci,qcow
    exit 0;
elif [[ $1 == "--help" ]]; then
    echo "Put yer helptext here"
    exit 1;
fi

parse_input() {
    # Read JSON input from stdin
    input_json=$(cat)
    # Parse the input JSON using jq
    action=$(echo "$input_json" | jq -r '.action')
    installation_name=$(echo "$input_json" | jq -r '.installation_name | gsub("[^a-zA-Z0-9-]"; "-")')
    revision=$(echo "$input_json" | jq -r '.revision')
    image=$(echo "$input_json" | jq -r '.image.image')
    environment=$(echo "$input_json" | jq -c '.environment')
    files=$(echo "$input_json" | jq -c '.files')
}

# Function to create environment variables string for docker command
create_env_vars() {
    local env_json=$1
    local env_vars=""
    # Set CNAB_ACTION environment variable
    # env_vars+=" -e CNAB_ACTION=\"$action\""
    for row in $(echo "$env_json" | jq -r 'to_entries[] | @base64'); do
        _jq() {
            echo "${row}" | base64 --decode | jq -r "${1}"
        }
        key=$(_jq '.key')
        value=$(_jq '.value')
        if [[ "$value" == "true" || "$value" == "false" ]]; then
            env_vars+=" -e $key=$value"
        else
            env_vars+=" -e $key=\"$value\""
        fi
    done
    echo "$env_vars"
}

# Function to create file mounts for docker command
create_file_mounts() {
    local files_json=$1
    local mounts=""
    temp_dir=$(mktemp -d)
    for row in $(echo "$files_json" | jq -r 'to_entries[] | @base64'); do
        _jq() {
            echo "${row}" | base64 --decode | jq -r "${1}"
        }
        file_path=$(_jq '.key')
        file_content=$(_jq '.value')
        host_path="$temp_dir$file_path"
        mkdir -p "$(dirname "$host_path")"
        echo -e "$file_content" > "$host_path"
        mounts+=" -v $host_path:$file_path"
    done
    echo "$mounts"
}

# Function to perform the specified action
perform_action() {
    case "$action" in
        install)
            run_invocation_image
            ;;
        upgrade)
            run_invocation_image
            ;;
        uninstall)
            run_invocation_image
            ;;
        *)
            echo "Unknown action: $action" >&2
            exit 1
            ;;
    esac
}

